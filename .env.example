GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
MY_WHATSAPP_NUMBER=

NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

DATABASE_URL=postgresql://local_agent_app:CHANGE_ME@localhost:5432/local_agent

# Optional — given to Claude Code when drafting an assignment, for
# submissions that must be identified/named with this (e.g. "Roll number:
# 22-CS-045, Name: Zain Sheikh"). Leave blank if not needed.
STUDENT_INFO=

# Optional — LangSmith tracing (get an API key at smith.langchain.com).
# Leave LANGSMITH_TRACING_V2 unset/false to disable; graph/LLM-call traces
# are sent to LangSmith's cloud, so only enable this with data you're okay
# leaving your own machine.
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=study-copilot
